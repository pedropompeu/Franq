# Única variável obrigatória (a partir do Dia 2)
GOOGLE_API_KEY=

# Opcionais (padrões entre parênteses)
# Provedor: gemini (padrão, AI Studio com GOOGLE_API_KEY) ou vertex (Vertex AI, sem chave:
# usa Application Default Credentials, ex.: `gcloud auth application-default login`)
# LLM_PROVIDER=gemini
# Só com LLM_PROVIDER=vertex:
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=southamerica-east1
# Modelos em ordem de fallback, "modelo:RPM". A cota do free tier é por modelo e zera à meia-noite do Pacífico.
# GEMINI_MODELS=gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15
# Cache das respostas do LLM: on (padrão), off ou replay (só cache, nunca chama a API)
# LLM_CACHE=on
# LLM_CACHE_DIR=.cache/llm
# TRACE_PATH=traces/traces.jsonl
# DB_PATH=data/anexo_desafio_1.db
# SQL_MAX_ROWS=1000
# SQL_MAX_ROWS_LLM=50
# SQL_TIMEOUT_S=5
# SCHEMA_MAX_CATEGORICAL=30

# Custo estimado (painel da aba Rastros). Preço em US$ por milhão de tokens, "entrada,saída".
# Sem a variável, a linha de custo não aparece. Preço público do gemini-3.5-flash-lite (tier pago, texto) em 13/11/2026:
# LLM_PRICE_USD_PER_MTOK=0.30,2.50

# API (make run-api ou serviço api do docker compose). Com API_KEY definida, toda rota exceto
# /health exige o cabeçalho X-API-Key com este valor.
# API_KEY=

# LangFuse (opcional). Com as duas chaves, cada decisão do modelo vira uma generation no LangFuse,
# só com mensagens já mascaradas ([nome_1], [email_1]); sem elas, nada é enviado.
# `make eval ARGS="--langfuse"` registra a rodada como execução do dataset "indaga-eval".
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com
