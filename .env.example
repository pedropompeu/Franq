# Única variável obrigatória (a partir do Dia 2)
GOOGLE_API_KEY=

# Opcionais (padrões entre parênteses)
# LLM_PROVIDER=gemini
# Modelos em ordem de fallback, "modelo:RPM". A cota do free tier é por modelo e zera à meia-noite do Pacífico.
# GEMINI_MODELS=gemini-3.5-flash-lite:15,gemini-3.1-flash-lite:15
# Cache das respostas do LLM: on (padrão), off ou replay (só cache, nunca chama a API)
# LLM_CACHE=on
# LLM_CACHE_DIR=.cache/llm
# TRACE_PATH=traces/traces.jsonl
# DB_PATH=data/anexo_desafio_1.db
# SQL_MAX_ROWS=1000
# SQL_MAX_ROWS_LLM=50
# SQL_TIMEOUT_S=5
# SCHEMA_MAX_CATEGORICAL=30
